<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Registration Successful</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head>
<body><main class="success-shell"><section class="success-card"><div class="check">✓</div><span class="eyebrow dark">REGISTRATION COMPLETE</span><h1>Welcome, <c:out value="${sessionScope.registeredStudent.name}"/>!</h1><p>Your student profile has been validated and registered successfully.</p><div class="summary"><div><small>EMAIL ID</small><b><c:out value="${sessionScope.registeredStudent.email}"/></b></div><div><small>COURSE</small><b><c:out value="${sessionScope.registeredStudent.course}"/></b></div></div><a class="button-link" href="${pageContext.request.contextPath}/register">Register another student →</a><p class="count">Students registered this session: <b><c:out value="${sessionScope.students.size()}"/></b></p></section></main></body></html>
